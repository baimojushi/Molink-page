<view class="page-container">
  <view class="login-overlay" wx:if="{{showLoginOverlay}}">
    <view class="login-card glass-card">
      <text class="login-title">效果图永久保存</text>
      <text class="login-desc">登录后绑定微信账号，随时查看与下载</text>
      <button class="btn-primary login-btn" bindtap="doWxLogin" disabled="{{loginLoading}}">
        {{loginLoading ? '登录中...' : '微信一键登录'}}
      </button>
      <text class="login-skip" bindtap="skipLogin">暂不登录</text>
    </view>
  </view>

  <view class="header-top">
    <view class="header-top-spacer"></view>
    <view class="history-entry touch-chip" bindtap="openHistory" hover-class="touch-chip-hover">
      <text class="history-entry-text">历史记录</text>
      <text wx:if="{{historyCount > 0}}" class="history-entry-badge">{{historyCount}}</text>
    </view>
  </view>

  <view class="header">
    <text class="logo" bindlongpress="onLogoLongPress">Mo:link 墨林设计</text>
    <text class="tagline">外滩艺博会作品-家居匹配服务</text>
  </view>

  <view wx:if="{{activeOrder}}" class="active-order-card pending" bindtap="goToActiveOrder">
    <view class="active-order-left">
      <text class="active-order-icon">◌</text>
      <view>
        <text class="active-order-title">效果图制作中</text>
        <text class="active-order-hint">完成后将第一时间通知您</text>
      </view>
    </view>
    <text class="active-order-arrow">→</text>
  </view>

  <view class="section-title">请选择您需要的服务</view>

  <view class="service-list">
    <view
      class="service-card glass-card {{selectedService === item.id ? 'selected' : ''}}"
      wx:for="{{services}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectService"
      hover-class="service-card-hover"
      hover-stay-time="90"
    >
      <view class="service-card-main">
        <image class="service-icon {{selectedService === item.id ? 'selected' : ''}}" src="{{item.iconPath}}" mode="aspectFit"></image>
        <view class="service-info">
          <text class="service-title">{{item.title}}</text>
          <text class="service-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="service-check {{selectedService === item.id ? 'checked' : ''}}">
        <text wx:if="{{selectedService === item.id}}">✓</text>
      </view>
    </view>
  </view>

  <view class="animation-stage">
    <view class="animation-stage-inner">
      <image wx:if="{{animationVisible && animationSrc}}" class="animation-media {{animationLoop ? 'looping' : ''}}" src="{{animationSrc}}" mode="aspectFit"></image>
    </view>
  </view>

  <view class="disclaimer">
    <text class="disclaimer-text">上传即承诺内容合法合规，不含政治敏感、违禁、侵权等违法违规内容，违规责任自负。</text>
    <text class="contact-text">Contact: mollink.art@gmail.com</text>
    <text class="privacy-link" bindtap="openPrivacy">· 隐私政策 ·</text>
    <text class="privacy-link" bindtap="openTerms">· 用户协议 ·</text>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary {{selectedService ? '' : 'disabled'}}" bindtap="goNext">下一步</button>
  </view>
</view>
