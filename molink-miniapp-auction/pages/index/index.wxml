<view class="page-container">
  <!-- 登录弹窗（未登录时必须点击） -->
  <view class="login-overlay" wx:if="{{showLoginOverlay}}">
    <view class="login-card glass-card">
      <text class="login-title">效果图永久保存</text>
      <text class="login-desc">登录后绑定微信账号，随时查看与下载</text>
      <button class="btn-primary login-btn" bindtap="doWxLogin" disabled="{{loginLoading}}">
        {{loginLoading ? '登录中...' : '微信一键登录'}}
      </button>
      <text class="login-skip" bindtap="skipLogin">暂不登录</text>
    </view>
  </view>

  <!-- 顶部标题：长按触发工作人员入口 -->
  <view class="header">
    <text
      class="logo"
      bindlongpress="onLogoLongPress"
    >Mollink 墨林艺术</text>
    <text class="tagline">艺术空间匹配服务</text>
  </view>

  <!-- 当前订单状态卡片 -->
  <view wx:if="{{activeOrder}}" class="active-order-card {{activeOrder.delivered ? 'delivered' : 'pending'}}" bindtap="goToActiveOrder">
    <view class="active-order-left">
      <text class="active-order-icon">{{activeOrder.delivered ? '✦' : '◌'}}</text>
      <view>
        <text class="active-order-title">{{activeOrder.delivered ? '效果图已准备好' : '效果图制作中'}}</text>
        <text class="active-order-hint">{{activeOrder.delivered ? '点击查看您的效果图' : '完成后将第一时间通知您'}}</text>
      </view>
    </view>
    <text class="active-order-arrow">→</text>
  </view>

  <!-- 服务选择 -->
  <view class="section-title">请选择您需要的服务</view>

  <view class="service-list">
    <view
      class="service-card glass-card {{selectedService === item.id ? 'selected' : ''}}"
      wx:for="{{services}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectService"
    >
      <image class="service-icon" src="{{item.iconPath}}" mode="aspectFit"></image>
      <view class="service-info">
        <text class="service-title">{{item.title}}</text>
        <text class="service-desc">{{item.desc}}</text>
      </view>
      <view class="service-check {{selectedService === item.id ? 'checked' : ''}}">
        <text wx:if="{{selectedService === item.id}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text class="disclaimer-text">上传即承诺内容合法合规，不含政治敏感、违禁、侵权等违法违规内容，违规责任自负。</text>
    <text class="contact-text">Contact: mollink.art@gmail.com</text>
    <text class="privacy-link" bindtap="openPrivacy">· 隐私政策 ·</text>
    <text class="privacy-link" bindtap="openTerms">· 用户协议 ·</text>
  </view>

  <!-- 下一步按钮 -->
  <view class="bottom-bar">
    <button
      class="btn-primary {{selectedService ? '' : 'disabled'}}"
      bindtap="goNext"
    >下一步</button>
  </view>
</view>
