<view class="page-container {{privacyAgreed ? 'privacy-agreed' : 'privacy-pending'}}">
  <view class="header-top">
    <view class="header-top-spacer"></view>
    <view class="history-entry touch-chip" bindtap="openHistory" hover-class="touch-chip-hover">
      <text class="history-entry-text">历史记录</text>
      <text wx:if="{{historyCount > 0}}" class="history-entry-badge">{{historyCount}}</text>
    </view>
  </view>

  <view class="header {{headerIntroDone ? 'intro-done' : ''}}">
    <text class="logo intro-fade-up" bindlongpress="onLogoLongPress" space="nbsp">Mo:link  墨林设计</text>

    <view class="exhibition-brand intro-fade-up">
      <text class="exhibition-brand-name">{{currentExhibitionName}}</text>
      <view
        class="exhibition-switch-button touch-chip"
        bindtap="switchExhibition"
        hover-class="exhibition-switch-button-hover"
        hover-stay-time="90"
      >
        <text class="exhibition-switch-text">定位/选择当前展览</text>
      </view>
    </view>
  </view>

  <view wx:if="{{exhibitionOrderDisabled}}" class="exhibition-ended-tip">该展览已结束，作品仍可浏览，暂不支持在线下单</view>

  <view wx:if="{{activeOrder}}" class="active-order-card pending" bindtap="goToActiveOrder">
    <view class="active-order-left">
      <text class="active-order-icon">◌</text>
      <view>
        <text class="active-order-title">效果图制作中</text>
        <text class="active-order-hint">完成后将第一时间通知您</text>
      </view>
    </view>
    <text class="active-order-arrow">→</text>
  </view>

  <view class="section-title">请选择您需要的服务</view>

  <view class="service-list">
    <view
      class="service-card glass-card {{selectedService === item.id ? 'selected' : ''}} {{exhibitionOrderDisabled ? 'service-disabled' : ''}} {{item.disabled ? 'service-unavailable' : ''}} {{cardIntroStep >= index + 1 ? 'card-entered' : 'card-pre-enter'}}"
      wx:for="{{services}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="selectService"
      hover-class="{{item.disabled ? '' : 'service-card-hover'}}"
      hover-stay-time="90"
    >
      <view class="service-card-main">
        <image class="service-icon {{selectedService === item.id ? 'selected' : ''}} {{item.disabled ? 'service-icon-dimmed' : ''}}" src="{{item.iconPath}}" mode="aspectFit"></image>
        <view class="service-info">
          <text class="service-title {{item.disabled ? 'service-title-dimmed' : ''}}">{{item.title}}</text>
          <text class="service-desc {{item.disabled ? 'service-desc-notice' : ''}}">{{item.desc}}</text>
        </view>
      </view>
      <view class="service-check {{selectedService === item.id ? 'checked' : ''}} {{item.disabled ? 'service-check-hidden' : ''}}">
        <text wx:if="{{selectedService === item.id}}">✓</text>
      </view>
    </view>
  </view>

  <view class="animation-stage">
    <view class="animation-stage-inner">
      <image
        wx:if="{{animationSlotA}}"
        class="animation-media layer-a {{activeAnimationSlot === 'A' ? 'is-active' : 'is-idle'}}"
        src="{{animationSlotA}}"
        mode="aspectFit"
        webp="{{true}}"
        binderror="onAnimationError"
      ></image>
      <image
        wx:if="{{animationSlotB}}"
        class="animation-media layer-b {{activeAnimationSlot === 'B' ? 'is-active' : 'is-idle'}}"
        src="{{animationSlotB}}"
        mode="aspectFit"
        webp="{{true}}"
        binderror="onAnimationError"
      ></image>
    </view>
  </view>

  <view class="disclaimer">
    <text class="disclaimer-text">上传即承诺内容合法合规，不含政治敏感、违禁、侵权等违法违规内容，违规责任自负。</text>
    <text class="contact-text">Contact: mollink.art@gmail.com</text>
    <text class="privacy-link" bindtap="openPrivacy">· 隐私政策 ·</text>
    <text class="privacy-link" bindtap="openTerms">· 用户协议 ·</text>
  </view>

  <view wx:if="{{!privacyAgreed}}" class="privacy-float glass-frost {{privacyShake ? 'privacy-shake' : ''}}">
    <view class="privacy-check-hit" bindtap="togglePrivacyAgreement" hover-class="privacy-check-hit-hover" hover-stay-time="80">
      <view class="privacy-checkbox"></view>
    </view>
    <view class="privacy-consent-copy {{privacyShake ? 'privacy-copy-alert' : ''}}">
      <text bindtap="togglePrivacyAgreement">请先阅读并勾选同意</text>
      <text class="privacy-consent-link" catchtap="openPrivacy">《隐私政策》</text>
      <text>和</text>
      <text class="privacy-consent-link" catchtap="openTerms">《用户协议》</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary {{selectedService && privacyAgreed && !exhibitionOrderDisabled ? '' : 'disabled'}}" bindtap="goNext">下一步</button>
  </view>
</view>
