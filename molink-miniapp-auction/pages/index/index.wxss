.login-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-card {
  margin: 0 48rpx;
  padding: 64rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.login-desc {
  font-size: 28rpx;
  color: #7a6a5a;
  text-align: center;
}

.login-btn {
  width: 100%;
  margin-top: 16rpx;
}

.login-skip {
  font-size: 26rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.header-top-spacer {
  width: 120rpx;
  height: 1rpx;
}

.touch-chip {
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}

.touch-chip-hover {
  transform: translateY(-2rpx) scale(0.99);
  opacity: 0.96;
}

.history-entry {
  min-width: 132rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(122, 158, 126, 0.12);
  border: 1rpx solid rgba(122, 158, 126, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.history-entry-text {
  font-size: 24rpx;
  color: var(--color-accent-dark);
}

.history-entry-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 48rpx;
}

.logo {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 3rpx;
}

.tagline {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-sub);
  margin-bottom: 24rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.service-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  min-height: 164rpx;
}

.service-card.selected {
  border-color: var(--color-accent);
  background: rgba(122, 158, 126, 0.14);
  box-shadow: 0 16rpx 32rpx rgba(122, 158, 126, 0.14);
}

.service-card-hover {
  transform: translateY(-2rpx) scale(0.996);
  opacity: 0.98;
}

.service-card-main {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
}

.service-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  opacity: 0.8;
  margin-top: 4rpx;
}

.service-info {
  flex: 1;
  min-width: 0;
}

.service-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.service-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  line-height: 1.6;
}

.service-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-text-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s ease;
}

.service-check.checked {
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.animation-stage {
  margin-top: 28rpx;
  margin-bottom: 40rpx;
  min-height: 300rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx dashed rgba(122, 158, 126, 0.16);
  transition: background 0.2s ease, border-color 0.2s ease;
}

.animation-stage.active {
  border-color: rgba(122, 158, 126, 0.28);
  background: rgba(255, 255, 255, 0.3);
}

.animation-stage-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.animation-stage-placeholder {
  width: 100%;
  max-width: 520rpx;
  min-height: 220rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.animation-stage-placeholder.selected {
  background: rgba(122, 158, 126, 0.08);
}

.animation-stage-guide {
  font-size: 24rpx;
  color: var(--color-text-disabled);
}

.animation-stage-anchor {
  width: 300rpx;
  height: 170rpx;
  border-radius: 20rpx;
  background: rgba(122, 158, 126, 0.12);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 239, 233, 0.98) 60%, transparent);
}

.btn-primary.disabled {
  background: var(--color-text-disabled);
}

.active-order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 32rpx;
}

.active-order-card.pending {
  background: rgba(145, 115, 85, 0.1);
  border: 1rpx solid rgba(145, 115, 85, 0.2);
}

.active-order-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.active-order-icon {
  font-size: 40rpx;
  color: var(--color-primary);
}

.active-order-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 4rpx;
}

.active-order-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.active-order-arrow {
  font-size: 28rpx;
  color: var(--color-primary-light);
}

.disclaimer {
  padding: 0 4rpx 32rpx;
}

.disclaimer-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.7;
  color: rgba(90, 90, 90, 0.28);
  letter-spacing: 0.5rpx;
  text-align: justify;
  text-indent: 2em;
}

.privacy-link {
  display: block;
  font-size: 22rpx;
  color: rgba(90, 90, 90, 0.55);
  text-align: center;
  margin-top: 10rpx;
  text-decoration: underline;
}

.contact-text {
  display: block;
  font-size: 22rpx;
  color: rgba(90, 90, 90, 0.5);
  text-align: center;
  margin-top: 16rpx;
}

@media (min-width: 520px) {
  .header-top { margin-bottom: 4px; }
  .history-entry { min-width: 84px; padding: 6px 10px; gap: 6px; }
  .history-entry-text { font-size: 12px; }
  .history-entry-badge { min-width: 18px; height: 18px; font-size: 10px; }
  .header { padding: 26px 0 28px; }
  .logo { font-size: 28px; letter-spacing: 2px; }
  .tagline { font-size: 13px; margin-top: 6px; }
  .section-title { font-size: 14px; margin-bottom: 14px; }
  .service-list { gap: 12px; }
  .service-card { padding: 16px 16px; gap: 14px; min-height: 88px; }
  .service-card-main { gap: 12px; }
  .service-icon { width: 28px; height: 28px; }
  .service-title { font-size: 16px; margin-bottom: 4px; }
  .service-desc { font-size: 12px; }
  .service-check { width: 22px; height: 22px; font-size: 12px; }
  .animation-stage { margin-top: 14px; margin-bottom: 22px; min-height: 160px; padding: 14px; }
  .animation-stage-placeholder { max-width: 280px; min-height: 112px; }
  .animation-stage-anchor { width: 160px; height: 92px; border-radius: 12px; }
  .bottom-bar { padding: 14px 24px; padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
  .active-order-card { padding: 14px 18px; margin-bottom: 18px; }
  .active-order-icon { font-size: 22px; }
  .active-order-title { font-size: 14px; }
  .active-order-hint { font-size: 12px; }
  .active-order-arrow { font-size: 14px; }
  .disclaimer-text { font-size: 11px; }
}
