.page-container {
  min-height: 100vh;
  padding: 32rpx 20rpx calc(396rpx + env(safe-area-inset-bottom));
  background: linear-gradient(160deg, #f5efe9 0%, #efe5db 100%);
  box-sizing: border-box;
}

.page-container.privacy-agreed {
  padding-bottom: calc(268rpx + env(safe-area-inset-bottom));
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.header-top-spacer {
  width: 120rpx;
  height: 1rpx;
}

.touch-chip {
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}

.touch-chip-hover {
  transform: translateY(-2rpx) scale(0.99);
  opacity: 0.96;
}

.history-entry {
  min-width: 132rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(122, 158, 126, 0.12);
  border: 1rpx solid rgba(122, 158, 126, 0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.history-entry-text {
  font-size: 24rpx;
  color: var(--color-accent-dark);
}

.history-entry-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 18rpx 34rpx;
}

.logo {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary-dark);
  letter-spacing: 3rpx;
  line-height: 1.12;
  text-align: center;
}

.exhibition-brand {
  width: 100%;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.exhibition-brand-name {
  display: -webkit-box;
  width: 100%;
  max-width: 650rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: var(--color-text-hint);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.8rpx;
  text-align: center;
  word-break: break-word;
}

.exhibition-switch-button {
  min-width: 132rpx;
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(122, 158, 126, 0.26);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.38);
  box-shadow: 0 8rpx 20rpx rgba(80, 64, 48, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.exhibition-switch-button-hover {
  transform: translateY(-1rpx) scale(0.97);
  opacity: 0.86;
  background: rgba(122, 158, 126, 0.12);
}

.exhibition-switch-text {
  color: var(--color-accent-dark);
  font-size: 22rpx;
  line-height: 1;
  letter-spacing: 0.4rpx;
}


.intro-fade-up {
  opacity: 0;
  transform: translateY(18rpx);
  transition: opacity 820ms ease, transform 1180ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}

.header.intro-done .intro-fade-up {
  opacity: 1;
  transform: translateY(0);
}

.header.intro-done .exhibition-brand {
  transition-delay: 140ms;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-sub);
  margin-bottom: 22rpx;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.service-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  padding: 28rpx 28rpx;
  border: 2rpx solid transparent;
  min-height: 148rpx;
  transition:
    transform 760ms cubic-bezier(0.2, 0.9, 0.2, 1.06),
    opacity 320ms ease,
    border-color 250ms ease,
    background 250ms ease,
    box-shadow 250ms ease;
}

.card-pre-enter {
  opacity: 0;
  transform: translateX(92rpx);
}

.card-entered {
  opacity: 1;
  transform: translateX(0);
}

.service-card.selected {
  border-color: var(--color-accent);
  background: rgba(122, 158, 126, 0.14);
  box-shadow: 0 16rpx 32rpx rgba(122, 158, 126, 0.14);
}

.service-card-hover {
  transform: translateY(-2rpx) scale(0.996);
  opacity: 0.98;
}

.service-card.service-unavailable {
  opacity: 0.55;
  background: rgba(200, 200, 205, 0.08);
  pointer-events: auto;
}

.service-icon-dimmed {
  opacity: 0.45;
  filter: grayscale(0.6);
}

.service-title-dimmed {
  color: var(--color-text-sub);
}

.service-desc-notice {
  color: rgba(120, 120, 128, 0.88);
  font-style: italic;
}

.service-notice-badge {
  display: inline-flex;
  align-items: center;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(142, 142, 148, 0.12);
  border: 1rpx solid rgba(142, 142, 148, 0.18);
}

.service-notice-badge text {
  font-size: 18rpx;
  line-height: 1.3;
  color: rgba(120, 120, 128, 0.92);
  letter-spacing: 0.5rpx;
}

.service-check-hidden {
  opacity: 0;
  pointer-events: none;
}

.service-card-main {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
}

.service-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  opacity: 0.8;
  margin-top: 4rpx;
  transition: transform 0.2s ease, opacity 0.2s ease, filter 0.2s ease;
}

.service-icon.selected {
  opacity: 1;
  transform: scale(1.02);
  filter: brightness(0) saturate(100%) invert(59%) sepia(10%) saturate(593%) hue-rotate(75deg) brightness(92%) contrast(86%);
}

.service-info {
  flex: 1;
  min-width: 0;
}

.service-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.service-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  line-height: 1.58;
}

.service-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-text-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  transition: all 0.2s ease;
}

.service-check.checked {
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.animation-stage {
  margin: 0;
  min-height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  contain: paint;
}

.animation-stage-inner {
  position: relative;
  width: 430rpx;
  height: 430rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  contain: paint;
}

.animation-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transform: scale(0.988);
  transition: opacity 220ms ease, transform 220ms ease;
  will-change: opacity, transform;
  backface-visibility: hidden;
  pointer-events: none;
}

.animation-media.is-active {
  opacity: 1;
  transform: scale(1);
}

.animation-media.is-idle {
  opacity: 0;
  transform: scale(0.994);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 239, 233, 0.98) 60%, transparent);
  z-index: 18;
}


.glass-frost {
  background: rgba(255, 255, 255, 0.56);
  -webkit-backdrop-filter: blur(28px) saturate(180%);
  backdrop-filter: blur(28px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 22rpx 54rpx rgba(80, 64, 48, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
}

.privacy-float {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 20;
  min-height: 116rpx;
  padding: 22rpx 26rpx 22rpx 18rpx;
  border-radius: 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transform: translateX(0);
  will-change: transform;
}

.privacy-check-hit {
  width: 96rpx;
  height: 96rpx;
  margin: -12rpx 0 -12rpx -6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 28rpx;
}

.privacy-check-hit-hover {
  background: rgba(122, 158, 126, 0.08);
}

.privacy-checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: 13rpx;
  border: 2rpx solid rgba(122, 158, 126, 0.8);
  background: rgba(122, 158, 126, 0.12);
  color: var(--color-accent-dark);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.privacy-consent-copy {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: rgba(42, 42, 42, 0.82);
  line-height: 1.58;
  letter-spacing: 0.2rpx;
}

.privacy-consent-link {
  color: var(--color-accent-dark);
  font-weight: 600;
  text-decoration: underline;
  padding: 18rpx 4rpx;
}

.privacy-copy-alert {
  color: #9a4b34;
  font-weight: 600;
  animation: privacyCopyPulse 520ms ease;
}

.privacy-shake {
  animation: privacyShake 520ms cubic-bezier(0.36, 0.07, 0.19, 0.97);
}

@keyframes privacyShake {
  0%, 100% { transform: translateX(0); }
  16% { transform: translateX(-12rpx); }
  32% { transform: translateX(10rpx); }
  48% { transform: translateX(-8rpx); }
  64% { transform: translateX(6rpx); }
  80% { transform: translateX(-3rpx); }
}

@keyframes privacyCopyPulse {
  0%, 100% { transform: scale(1); }
  45% { transform: scale(1.02); }
}

.btn-primary.disabled {
  background: var(--color-text-disabled);
}

.active-order-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: var(--radius-lg);
  margin-bottom: 28rpx;
}

.active-order-card.pending {
  background: rgba(145, 115, 85, 0.1);
  border: 1rpx solid rgba(145, 115, 85, 0.2);
}

.active-order-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.active-order-icon {
  font-size: 40rpx;
  color: var(--color-primary);
}

.active-order-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 4rpx;
}

.active-order-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.active-order-arrow {
  font-size: 28rpx;
  color: var(--color-primary-light);
}

.disclaimer {
  padding: 0 4rpx 48rpx;
}

.disclaimer-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.7;
  color: rgba(90, 90, 90, 0.28);
  letter-spacing: 0.5rpx;
  text-align: justify;
  text-indent: 2em;
}

.privacy-link {
  display: block;
  font-size: 22rpx;
  color: rgba(90, 90, 90, 0.55);
  text-align: center;
  margin-top: 10rpx;
  text-decoration: underline;
}

.contact-text {
  display: block;
  font-size: 22rpx;
  color: rgba(90, 90, 90, 0.5);
  text-align: center;
  margin-top: 16rpx;
}

@media (min-width: 520px) {
  .page-container { padding: 18px 18px calc(226px + env(safe-area-inset-bottom)); }
  .page-container.privacy-agreed { padding-bottom: calc(158px + env(safe-area-inset-bottom)); }
  .header-top { margin-bottom: 4px; }
  .history-entry { min-width: 84px; padding: 6px 10px; gap: 6px; }
  .history-entry-text { font-size: 12px; }
  .history-entry-badge { min-width: 18px; height: 18px; font-size: 10px; }
  .header { padding: 18px 12px 22px; }
  .logo { font-size: 28px; letter-spacing: 2px; line-height: 1.12; }
  .exhibition-brand { margin-top: 10px; }
  .exhibition-brand-name { max-width: 420px; font-size: 13px; line-height: 1.5; }
  .exhibition-switch-button { min-width: 76px; height: 26px; margin-top: 7px; padding: 0 12px; }
  .exhibition-switch-text { font-size: 11px; }
  .section-title { font-size: 14px; margin-bottom: 12px; }
  .service-list { gap: 10px; }
  .service-card { padding: 14px 16px; gap: 14px; min-height: 80px; }
  .card-pre-enter { transform: translateX(48px); }
  .service-card-main { gap: 12px; }
  .service-icon { width: 28px; height: 28px; }
  .service-title { font-size: 16px; margin-bottom: 4px; }
  .service-desc { font-size: 12px; }
  .service-check { width: 22px; height: 22px; font-size: 12px; }
  .animation-stage { margin: 0; min-height: 238px; }
  .animation-stage-inner { width: 246px; height: 246px; }
  .bottom-bar { padding: 14px 24px; padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
  .privacy-float { left: 24px; right: 24px; bottom: calc(78px + env(safe-area-inset-bottom)); min-height: 62px; padding: 10px 14px 10px 8px; border-radius: 20px; gap: 4px; }
  .privacy-check-hit { width: 56px; height: 56px; margin: -8px 0 -8px -4px; border-radius: 16px; }
  .privacy-checkbox { width: 22px; height: 22px; border-radius: 7px; font-size: 14px; }
  .privacy-consent-copy { font-size: 12px; line-height: 1.5; }
  .privacy-consent-link { padding: 8px 2px; }
  .active-order-card { padding: 14px 18px; margin-bottom: 16px; }
  .active-order-icon { font-size: 22px; }
  .active-order-title { font-size: 14px; }
  .active-order-hint { font-size: 12px; }
  .active-order-arrow { font-size: 14px; }
  .disclaimer { padding-bottom: 32px; }
  .disclaimer-text { font-size: 11px; }
}


.exhibition-ended-tip {
  margin: -10rpx 4rpx 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(157, 95, 85, 0.09);
  border: 1rpx solid rgba(157, 95, 85, 0.12);
  color: #8f584f;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.service-card.service-disabled {
  opacity: 0.5;
  filter: grayscale(0.25);
}
