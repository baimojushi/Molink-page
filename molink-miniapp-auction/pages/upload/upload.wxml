<view class="page-container">
  <view class="header">
    <text class="service-tag">{{serviceLabel}}</text>
    <text class="page-title">上传图片</text>
  </view>

  <view wx:if="{{showArtworkSelect}}" class="upload-section">
    <view class="upload-label">选择参展作品</view>
    <view class="upload-hint">请检索或扫码本场展览中的作品</view>

    <view class="artwork-entry-row">
      <view class="search-entry glass-card touch-card" bindtap="openArtworkPanel" hover-class="touch-card-hover">
        <view class="search-entry-main">
          <image class="search-entry-icon-image" src="/assets/icons/search-minimal.svg" mode="aspectFit"></image>
          <view class="search-entry-copy">
            <text class="search-entry-title">作品检索</text>
            <text class="search-entry-sub">点击展开完整作品列表</text>
          </view>
        </view>
      </view>
      <view class="scan-entry glass-card touch-card" bindtap="scanArtwork" hover-class="touch-card-hover">
        <image class="scan-entry-icon-image {{scanLoading ? 'is-loading' : ''}}" src="/assets/icons/scan-qr.svg" mode="aspectFit"></image>
      </view>
    </view>

    <view wx:if="{{artworkPanelOpen}}" class="artwork-panel glass-card">
      <view class="artwork-panel-top">
        <input
          class="artwork-search-input"
          type="text"
          placeholder="输入作品名称 / 编号 / 作者"
          placeholder-class="input-placeholder"
          value="{{artworkSearchKeyword}}"
          bindinput="onArtworkSearchInput"
        />
        <view class="artwork-panel-close" bindtap="closeArtworkPanel">收起</view>
      </view>
      <view wx:if="{{loadingArtworks}}" class="artwork-loading">作品列表加载中...</view>
      <scroll-view wx:else scroll-y class="artwork-results-scroll">
        <view wx:if="{{filteredArtworks.length === 0}}" class="artwork-empty">未找到匹配作品</view>
        <view
          wx:for="{{filteredArtworks}}"
          wx:key="num"
          class="artwork-result-item touch-card"
          data-artwork="{{item}}"
          bindtap="chooseArtwork"
          hover-class="touch-card-hover"
        >
          <image class="artwork-result-image" src="{{item.images[0]}}" mode="aspectFill" lazy-load show-menu-by-longpress="{{false}}"></image>
          <view class="artwork-result-info">
            <text class="artwork-result-name">{{item.name || '（无题）'}}</text>
            <text class="artwork-result-meta">{{item.author || ''}}</text>
            <text class="artwork-result-meta">{{item.medium || ''}} {{item.size || ''}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{presetArtwork}}" class="preset-artwork-card glass-card touch-card" hover-class="touch-card-hover">
      <image class="preset-artwork-img" src="{{presetArtwork.images[0]}}" mode="aspectFill" bindtap="openArtworkPreview" data-src="{{presetArtwork.images[0]}}" show-menu-by-longpress="{{false}}" />
      <view class="preset-artwork-info">
        <text class="preset-artwork-name">{{presetArtwork.name || '（无题）'}}</text>
        <text class="preset-artwork-author">{{presetArtwork.author}}</text>
        <text class="preset-artwork-meta">{{presetArtwork.medium}} {{presetArtwork.size}}</text>
      </view>
      <view class="preset-artwork-actions">
        <view class="preset-preview-btn" bindtap="openArtworkPreview" data-src="{{presetArtwork.images[0]}}">查看大图</view>
        <view class="preset-reselect-btn" bindtap="openArtworkPanel">重新选择</view>
        <view class="remove-btn static-remove" bindtap="clearArtwork">✕</view>
      </view>
    </view>
  </view>

  <view class="upload-section" wx:for="{{uploadConfig}}" wx:key="key">
    <view class="upload-label">{{item.label}}</view>
    <view class="upload-hint">{{item.hint}}</view>

    <view class="image-preview glass-card" wx:if="{{images[item.key]}}">
      <image class="preview-img" src="{{images[item.key]}}" mode="aspectFill" bindtap="previewImage" data-src="{{images[item.key]}}" show-menu-by-longpress="{{false}}" />
      <view class="remove-btn" bindtap="removeImage" data-key="{{item.key}}">✕</view>
    </view>

    <view class="upload-box glass-card touch-card" wx:else bindtap="chooseImage" data-key="{{item.key}}" hover-class="touch-card-hover">
      <text class="upload-icon">+</text>
      <text class="upload-text">拍摄 / 上传</text>
      <text wx:if="{{item.key === 'space'}}" class="upload-privacy-tip">处理完成后自动清除</text>
    </view>
  </view>

  <view wx:if="{{showExtraOptimize}}" class="extra-optimize-row">
    <text class="extra-optimize-label">顺带微调软装细节（靠枕·织物·小摆件）</text>
    <switch class="extra-optimize-switch" checked="{{extraOptimize}}" color="#7a9e7e" bindchange="onExtraOptimizeChange" />
  </view>

  <view class="email-section">
    <text class="section-inline-label">效果图完成后发到您邮箱（选填）</text>
    <input
      class="email-input glass-card"
      type="text"
      value="{{email}}"
      bindinput="onEmailInput"
    />
  </view>

  <view class="bottom-bar">
    <button class="btn-primary {{submitting ? 'disabled' : ''}}" bindtap="submitOrder" disabled="{{submitting}}">
      <text wx:if="{{!submitting}}">提交</text>
      <text wx:else>提交中...</text>
    </button>
    <text class="submit-tip">提交时询问是否接收效果图完成通知</text>
  </view>

  <view wx:if="{{showArtworkPreview}}" class="artwork-preview-mask" bindtap="closeArtworkPreview" catchtouchmove="noop">
    <view class="artwork-preview-shell" catchtap="noop">
      <image class="artwork-preview-image" src="{{artworkPreviewUrl}}" mode="aspectFit" show-menu-by-longpress="{{false}}"></image>
      <view class="artwork-preview-close" bindtap="closeArtworkPreview">关闭</view>
    </view>
  </view>
</view>
