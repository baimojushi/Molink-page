.page-container {
  min-height: 100vh;
  padding: 32rpx 20rpx 192rpx;
  background: linear-gradient(160deg, #f5efe9 0%, #efe5db 100%);
  box-sizing: border-box;
}

.header {
  padding: 28rpx 4rpx 32rpx;
}

.service-tag {
  display: block;
  font-size: 22rpx;
  color: var(--color-accent);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.upload-section {
  margin-bottom: 32rpx;
}

.upload-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
}

.touch-card {
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

.touch-card-hover {
  transform: translateY(-2rpx) scale(0.995);
  opacity: 0.96;
}

.artwork-entry-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.search-entry {
  flex: 1;
  min-height: 132rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.search-entry-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.search-entry-icon-image {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.search-entry-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.search-entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.search-entry-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.scan-entry {
  width: 160rpx;
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.scan-entry-icon-image {
  width: 84rpx;
  height: 84rpx;
  opacity: 0.92;
}

.scan-entry-icon-image.is-loading {
  opacity: 0.56;
}

.artwork-panel {
  margin-top: 16rpx;
  padding: 20rpx;
}

.artwork-panel-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.artwork-search-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 26rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  box-sizing: border-box;
}

.artwork-panel-close {
  font-size: 24rpx;
  color: var(--color-primary);
  padding: 0 8rpx;
  flex-shrink: 0;
}

.artwork-results-scroll {
  max-height: 560rpx;
}

.artwork-result-item {
  display: flex;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(145, 115, 85, 0.08);
}

.artwork-result-item:first-child {
  border-top: none;
}

.artwork-result-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 14rpx;
  background: #e8dfd5;
  flex-shrink: 0;
}

.artwork-result-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.artwork-result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.artwork-result-meta {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.artwork-loading,
.artwork-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.preset-artwork-card {
  margin-top: 18rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx;
}

.preset-artwork-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #e8dfd5;
}

.preset-artwork-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.preset-artwork-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.preset-artwork-author,
.preset-artwork-meta {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.preset-artwork-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.preset-preview-btn,
.preset-reselect-btn {
  font-size: 24rpx;
  color: var(--color-accent);
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  border: 2rpx dashed var(--color-primary-light);
}

.upload-icon {
  font-size: 64rpx;
  color: var(--color-primary-light);
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

.image-preview {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.static-remove {
  position: static;
  background: rgba(145, 115, 85, 0.12);
  color: var(--color-primary-dark);
}

.upload-privacy-tip {
  font-size: 20rpx;
  color: var(--color-text-disabled);
  margin-top: 10rpx;
  letter-spacing: 0.5rpx;
}

.extra-optimize-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 18rpx 4rpx 24rpx;
}

.extra-optimize-switch {
  flex-shrink: 0;
  transform: scale(0.92);
  transform-origin: center right;
}

.extra-optimize-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-sub);
  line-height: 1.6;
}

.section-inline-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-bottom: 12rpx;
}

.email-section {
  width: 100%;
  margin-bottom: 168rpx;
  margin-top: 8rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.email-input {
  display: block;
  width: calc(100% + 12rpx);
  max-width: none;
  min-width: 0;
  margin-left: -6rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
}

.input-placeholder {
  color: var(--color-text-disabled);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 239, 233, 0.98) 60%, transparent);
}

.submit-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

.artwork-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(20, 20, 20, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.artwork-preview-shell {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.artwork-preview-image {
  width: 100%;
  max-height: 76vh;
  border-radius: 24rpx;
}

.artwork-preview-close {
  min-width: 160rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  text-align: center;
  font-size: 26rpx;
}

@media (min-width: 520px) {
  .page-container { padding: 18px 18px 120px; }
  .header { padding: 18px 4px 18px; }
  .service-tag { font-size: 12px; margin-bottom: 4px; }
  .page-title { font-size: 24px; }
  .upload-label { font-size: 16px; margin-bottom: 4px; }
  .upload-hint { font-size: 12px; margin-bottom: 10px; }
  .artwork-entry-row { gap: 10px; }
  .search-entry, .scan-entry { min-height: 78px; }
  .search-entry { padding: 14px; }
  .search-entry-main { gap: 10px; }
  .search-entry-icon-image { width: 24px; height: 24px; }
  .search-entry-title { font-size: 14px; }
  .search-entry-sub { font-size: 11px; }
  .scan-entry { width: 90px; }
  .scan-entry-icon-image { width: 48px; height: 48px; }
  .artwork-panel { margin-top: 10px; padding: 12px; }
  .artwork-panel-top { gap: 10px; margin-bottom: 10px; }
  .artwork-search-input { height: 54px; line-height: 54px; padding: 0 14px; font-size: 13px; }
  .artwork-panel-close { font-size: 12px; }
  .artwork-results-scroll { max-height: 320px; }
  .artwork-result-item { gap: 12px; padding: 10px 0; }
  .artwork-result-image { width: 72px; height: 72px; border-radius: 10px; }
  .artwork-result-name { font-size: 14px; }
  .artwork-result-meta, .artwork-loading, .artwork-empty { font-size: 11px; }
  .preset-artwork-card { margin-top: 12px; gap: 12px; padding: 12px; }
  .preset-artwork-img { width: 88px; height: 88px; border-radius: 10px; }
  .preset-artwork-name { font-size: 14px; }
  .preset-artwork-author, .preset-artwork-meta, .preset-preview-btn, .preset-reselect-btn { font-size: 11px; }
  .upload-box, .image-preview { height: 170px; }
  .upload-icon { font-size: 36px; }
  .upload-text { font-size: 13px; margin-top: 6px; }
  .remove-btn { top: 10px; right: 10px; width: 28px; height: 28px; font-size: 13px; }
  .upload-privacy-tip { font-size: 10px; margin-top: 6px; }
  .extra-optimize-row { gap: 8px; margin: 12px 4px 16px; }
  .extra-optimize-label, .section-inline-label, .submit-tip { font-size: 12px; }
  .email-section { margin-bottom: 104px; }
  .email-input { height: 54px; line-height: 54px; padding: 0 18px; font-size: 14px; border-radius: 14px; }
  .bottom-bar { padding: 14px 20px; padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
  .artwork-preview-shell { gap: 12px; }
  .artwork-preview-close { min-width: 96px; padding: 10px 18px; font-size: 13px; }
}
