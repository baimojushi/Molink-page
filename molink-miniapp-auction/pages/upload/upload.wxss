.header {
  padding: 40rpx 0 32rpx;
}

.service-tag {
  display: block;
  font-size: 22rpx;
  color: var(--color-accent);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-main);
}

.upload-section {
  margin-bottom: 32rpx;
}

.upload-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 16rpx;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
  border: 2rpx dashed var(--color-primary-light);
}

.upload-icon {
  font-size: 64rpx;
  color: var(--color-primary-light);
  line-height: 1;
}

.upload-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

.image-preview {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0,0,0,0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.upload-privacy-tip {
  font-size: 20rpx;
  color: var(--color-text-disabled);
  margin-top: 10rpx;
  letter-spacing: 0.5rpx;
}

.upload-photo-tip {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-disabled);
  margin-top: 10rpx;
  text-align: center;
}

/* 尺寸输入 */
.size-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.size-label {
  font-size: 26rpx;
  color: var(--color-text-sub);
  white-space: nowrap;
}
.size-input {
  flex: 1;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 软装优化勾选 */
.extra-optimize-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 16rpx 0 24rpx;
}
.extra-optimize-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 6rpx;
  border: 1.5rpx solid var(--color-text-sub);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #fff;
}
.extra-optimize-check.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}
.extra-optimize-label {
  font-size: 26rpx;
  color: var(--color-text-sub);
}

/* 邮箱（常显） */
.email-section {
  margin-bottom: 160rpx;
  margin-top: 8rpx;
}

.email-input {
  width: 100%;
  padding: 28rpx 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--color-text-disabled);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 239, 233, 0.98) 60%, transparent);
}

.submit-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 12rpx;
}

.btn-primary.disabled {
  background: var(--color-text-disabled);
}

/* 从作品库选择 */
.select-artwork-box {
  height: 160rpx;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
}
.select-artwork-box .upload-icon {
  font-size: 48rpx;
  margin-bottom: 0;
}
.upload-sub-text {
  font-size: 22rpx;
  color: var(--color-text-disabled);
  margin-top: 4rpx;
}

/* 已选作品卡片 */
.preset-artwork-card {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  padding: 16rpx;
  align-items: center;
  border-radius: 20rpx;
}
.preset-artwork-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8dfd5;
}
.preset-artwork-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  justify-content: center;
}
.preset-artwork-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-main);
}
.preset-artwork-author {
  font-size: 24rpx;
  color: var(--color-accent);
}
.preset-artwork-meta {
  font-size: 22rpx;
  color: var(--color-text-disabled);
}
.preset-artwork-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
}
.preset-reselect-btn {
  font-size: 22rpx;
  color: var(--color-accent);
  background: rgba(145,115,85,0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

@media (min-width: 520px) {
  .header { padding: 24px 0 18px; }
  .service-tag { font-size: 12px; }
  .page-title { font-size: 22px; }
  .upload-label { font-size: 14px; margin-bottom: 4px; }
  .upload-hint { font-size: 12px; margin-bottom: 10px; }
  .upload-box { height: 150px; }
  .upload-icon { font-size: 32px; }
  .upload-text { font-size: 13px; margin-top: 8px; }
  .image-preview { height: 150px; }
  .email-section { margin-bottom: 100px; }
  .email-header { margin-bottom: 10px; }
  .email-input { padding: 14px 16px; font-size: 14px; }
  .size-label { font-size: 13px; }
  .size-input { padding: 10px 14px; font-size: 13px; }
  .upload-section { margin-bottom: 18px; }
  .bottom-bar { padding: 14px 24px; padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
  .submit-tip { font-size: 12px; margin-top: 8px; }
  .upload-photo-tip { font-size: 11px; }
  .upload-privacy-tip { font-size: 11px; margin-top: 6px; }
}
