.page-container.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f6f1ea;
}

.history-header {
  margin-bottom: 28rpx;
}

.history-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #2e2924;
  letter-spacing: -0.8rpx;
}

.history-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d8376;
}

.history-body {
  min-height: 240rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 54rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 248, 0.82);
  border: 1rpx solid rgba(177, 153, 126, 0.12);
  box-shadow: 0 10rpx 30rpx rgba(98, 79, 54, 0.06);
}

.empty-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  font-size: 34rpx;
  color: #a58c6b;
  background: rgba(165, 140, 107, 0.08);
}

.empty-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #3a332d;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a8f81;
}

.waterfall {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.waterfall-column {
  flex: 1;
  min-width: 0;
}

.waterfall-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 248, 0.9);
  border: 1rpx solid rgba(177, 153, 126, 0.12);
  box-shadow: 0 10rpx 26rpx rgba(98, 79, 54, 0.08);
  transform: translateY(0);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.waterfall-card-hover {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 32rpx rgba(98, 79, 54, 0.12);
}

.waterfall-image {
  display: block;
  width: 100%;
  background: #efe7dc;
}

.waterfall-copy {
  padding: 18rpx 18rpx 20rpx;
}

.waterfall-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #2f2a24;
  font-weight: 600;
}

.waterfall-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8f8579;
}

.history-footer {
  padding-top: 14rpx;
}

.login-reminder {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 253, 250, 0.92) 0%, rgba(252, 247, 241, 0.96) 100%);
  border: 1rpx solid rgba(177, 153, 126, 0.16);
  box-shadow: 0 12rpx 32rpx rgba(98, 79, 54, 0.08);
}

.login-reminder-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #a4845f;
  background: rgba(164, 132, 95, 0.12);
}

.login-reminder-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #302923;
}

.login-reminder-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #887d70;
}

.login-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.login-benefit-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #7d6a53;
  background: rgba(125, 106, 83, 0.08);
}

.login-btn {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 999rpx;
}

.login-secondary {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8e8275;
}

.status-tip {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a09588;
}
