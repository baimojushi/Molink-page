.page-container.history-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f6f1ea;
}

.history-header {
  margin-bottom: 28rpx;
}

.history-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #2e2924;
  letter-spacing: -0.8rpx;
}

.history-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8d8376;
}

.history-body {
  min-height: 240rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 54rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 248, 0.82);
  border: 1rpx solid rgba(177, 153, 126, 0.12);
  box-shadow: 0 10rpx 30rpx rgba(98, 79, 54, 0.06);
}

.empty-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  font-size: 34rpx;
  color: #a58c6b;
  background: rgba(165, 140, 107, 0.08);
}

.empty-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #3a332d;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #9a8f81;
}

.waterfall {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.waterfall-column {
  flex: 1;
  min-width: 0;
}

.waterfall-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 252, 248, 0.9);
  border: 1rpx solid rgba(177, 153, 126, 0.12);
  box-shadow: 0 10rpx 26rpx rgba(98, 79, 54, 0.08);
  transform: translateY(0);
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.waterfall-card-hover {
  transform: translateY(-4rpx);
  box-shadow: 0 16rpx 32rpx rgba(98, 79, 54, 0.12);
}

.waterfall-image {
  display: block;
  width: 100%;
  background: #efe7dc;
}

.waterfall-copy {
  padding: 18rpx 18rpx 20rpx;
}

.waterfall-title {
  display: block;
  font-size: 26rpx;
  line-height: 1.45;
  color: #2f2a24;
  font-weight: 600;
}

.waterfall-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8f8579;
}

.history-footer {
  padding-top: 14rpx;
}

.login-reminder {
  margin-top: 18rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 253, 250, 0.92) 0%, rgba(252, 247, 241, 0.96) 100%);
  border: 1rpx solid rgba(177, 153, 126, 0.16);
  box-shadow: 0 12rpx 32rpx rgba(98, 79, 54, 0.08);
}

.login-reminder-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #a4845f;
  background: rgba(164, 132, 95, 0.12);
}

.login-reminder-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #302923;
}

.login-reminder-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #887d70;
}

.login-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.login-benefit-pill {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #7d6a53;
  background: rgba(125, 106, 83, 0.08);
}

.login-btn {
  width: 100%;
  margin-top: 22rpx;
  border-radius: 999rpx;
}

.login-secondary {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8e8275;
}

.status-tip {
  padding: 28rpx 0 8rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: #a09588;
}

@import '../../utils/fullscreenViewer.wxss';

.history-viewer-advisor-dock {
  position: fixed;
  left: 18rpx;
  top: calc(env(safe-area-inset-top) + 108rpx);
  z-index: 10002;
  display: flex;
  justify-content: flex-start;
  pointer-events: none;
}

.history-viewer-advisor-card,
.history-viewer-advisor-pill {
  box-sizing: border-box;
  pointer-events: auto;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  background: rgba(246, 246, 248, 0.52);
  -webkit-backdrop-filter: blur(28px) saturate(138%);
  backdrop-filter: blur(28px) saturate(138%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.11);
}

.history-viewer-advisor-card {
  width: auto;
  max-width: 470rpx;
  min-height: 76rpx;
  padding: 9rpx 9rpx 9rpx 10rpx;
  display: flex;
  align-items: center;
  border-radius: 22rpx;
  transform-origin: left top;
  animation: historyViewerAdvisorExpand 300ms cubic-bezier(0.22, 0.8, 0.28, 1) both;
}

@keyframes historyViewerAdvisorExpand {
  from {
    opacity: 0.68;
    transform: translateY(-5rpx) scale(0.84);
  }
  68% {
    opacity: 1;
    transform: translateY(1rpx) scale(1.012);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.history-viewer-advisor-card-pressed {
  opacity: 0.8;
}

.history-viewer-advisor-avatar {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: rgba(255, 255, 255, 0.34);
  color: #48484a;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
}

.history-viewer-advisor-copy {
  min-width: 0;
  flex: 1;
  margin-left: 10rpx;
}

.history-viewer-advisor-name,
.history-viewer-advisor-wechat {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-viewer-advisor-name {
  font-size: 20rpx;
  line-height: 1.3;
  color: #2c2c2e;
  font-weight: 600;
}

.history-viewer-advisor-wechat {
  margin-top: 2rpx;
  font-size: 16rpx;
  line-height: 1.25;
  color: #6e6e73;
}

.history-viewer-advisor-action {
  min-width: 58rpx;
  height: 46rpx;
  margin-left: 10rpx;
  padding: 0 11rpx;
  box-sizing: border-box;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.36);
  color: #3a3a3c;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
  transition: opacity 140ms ease, transform 140ms ease, background 140ms ease;
}

.history-viewer-advisor-action-pressed {
  opacity: 0.62;
  transform: scale(0.96);
}

.history-viewer-advisor-action.is-copied {
  background: rgba(255, 255, 255, 0.52);
  color: #1c1c1e;
}

.history-viewer-advisor-toggle {
  width: 30rpx;
  height: 30rpx;
  margin-left: 4rpx;
  flex: 0 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
}

.history-viewer-advisor-chevron {
  width: 9rpx;
  height: 9rpx;
  box-sizing: border-box;
  border-right: 2rpx solid rgba(72, 72, 74, 0.68);
  border-bottom: 2rpx solid rgba(72, 72, 74, 0.68);
}

.chevron-down {
  transform: rotate(45deg) translate(-1rpx, -1rpx);
}

.chevron-right {
  margin: 0 10rpx 0 4rpx;
  transform: rotate(-45deg);
}

.history-viewer-advisor-pill {
  height: 64rpx;
  padding: 8rpx 2rpx 8rpx 8rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  transform-origin: left top;
  animation: historyViewerAdvisorCollapse 250ms cubic-bezier(0.22, 0.8, 0.28, 1) both;
}

@keyframes historyViewerAdvisorCollapse {
  from {
    opacity: 0.7;
    transform: scale(1.08);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.history-viewer-advisor-pill-pressed {
  opacity: 0.66;
  transform: scale(0.97);
}

.history-viewer-advisor-avatar-compact {
  width: 48rpx;
  height: 48rpx;
  flex-basis: 48rpx;
}

.history-viewer-advisor-pill-text {
  margin-left: 8rpx;
  color: #48484a;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .history-viewer-advisor-card {
    max-width: 466rpx;
  }

  .history-viewer-advisor-wechat {
    max-width: 190rpx;
  }
}

@media (min-width: 600px) {
  .history-viewer-advisor-dock {
    left: 18px;
    top: calc(env(safe-area-inset-top) + 68px);
  }

  .history-viewer-advisor-card {
    max-width: 294px;
    min-height: 48px;
    padding: 6px;
    border-radius: 14px;
  }

  .history-viewer-advisor-avatar {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
    border-radius: 9px;
    font-size: 12px;
  }

  .history-viewer-advisor-copy {
    margin-left: 7px;
  }

  .history-viewer-advisor-name {
    font-size: 12px;
  }

  .history-viewer-advisor-wechat {
    font-size: 10px;
  }

  .history-viewer-advisor-action {
    min-width: 38px;
    height: 30px;
    margin-left: 7px;
    padding: 0 7px;
    border-radius: 9px;
    font-size: 10px;
  }

  .history-viewer-advisor-toggle {
    width: 20px;
    height: 20px;
    margin-left: 3px;
    flex-basis: 20px;
  }

  .history-viewer-advisor-chevron {
    width: 6px;
    height: 6px;
    border-width: 1.5px;
  }

  .history-viewer-advisor-pill {
    height: 42px;
    padding: 6px 2px 6px 6px;
  }

  .history-viewer-advisor-avatar-compact {
    width: 30px;
    height: 30px;
    flex-basis: 30px;
  }

  .history-viewer-advisor-pill-text {
    margin-left: 6px;
    font-size: 11px;
  }

  .chevron-right {
    margin: 0 7px 0 3px;
  }
}
