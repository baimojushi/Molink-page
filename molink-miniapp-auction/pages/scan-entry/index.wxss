page {
  background: #f5efe9;
}

.entry-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f5efe9;
}

.entry-hero-stage,
.entry-hero-fallback {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.entry-hero-stage {
  overflow: hidden;
}

.entry-hero-track {
  position: absolute;
  top: 0;
  left: 0;
  will-change: transform;
  transform: translate3d(0, 0, 0);
}

.entry-hero {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 720ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.entry-hero-visible {
  opacity: 1;
}

.entry-hero-fallback {
  background: linear-gradient(180deg, #ddd4ca 0%, #cfc1b0 100%);
}

.entry-loading-panel {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
  text-align: center;
  color: rgba(91, 72, 54, 0.96);
  background: radial-gradient(circle at center, rgba(245, 239, 233, 0.88) 0%, rgba(245, 239, 233, 0.72) 48%, rgba(245, 239, 233, 0.28) 100%);
}

.entry-artwork-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  max-width: 560rpx;
  text-shadow: 0 8rpx 24rpx rgba(255, 255, 255, 0.78);
}

.entry-artwork-title {
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.entry-artwork-line {
  font-size: 27rpx;
  line-height: 1.45;
  color: rgba(112, 84, 63, 0.94);
}

.entry-loading-line {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: rgba(112, 84, 63, 0.88);
}

.entry-loading-dots {
  display: inline-flex;
  gap: 6rpx;
  align-items: center;
}

.entry-loading-dots text {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(112, 84, 63, 0.72);
  animation: loadingDot 1.05s ease-in-out infinite;
}

.entry-loading-dots text:nth-child(2) { animation-delay: 0.16s; }
.entry-loading-dots text:nth-child(3) { animation-delay: 0.32s; }

@keyframes loadingDot {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.35; }
  40% { transform: translateY(-8rpx); opacity: 1; }
}

.entry-bottom-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34vh;
  pointer-events: none;
  background: linear-gradient(
    180deg,
    rgba(245, 239, 233, 0) 0%,
    rgba(245, 239, 233, 0.18) 36%,
    rgba(245, 239, 233, 0.72) 76%,
    rgba(245, 239, 233, 0.96) 100%
  );
}

.entry-error {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(220rpx + env(safe-area-inset-bottom));
  z-index: 2;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(112, 84, 63, 0.96);
  text-shadow: 0 8rpx 22rpx rgba(255, 255, 255, 0.72);
}

.entry-gesture {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 2;
  transition: transform 180ms ease;
}

.entry-arrow {
  font-size: 52rpx;
  line-height: 1;
  color: #f5efe9;
  transform: scaleX(1.18) scaleY(0.82);
  text-shadow:
    0 8rpx 22rpx rgba(88, 74, 58, 0.48),
    0 0 10rpx rgba(88, 74, 58, 0.22);
}

.entry-hint {
  font-size: 28rpx;
  line-height: 1.5;
  letter-spacing: 3rpx;
  color: #f5efe9;
  text-shadow:
    0 8rpx 22rpx rgba(88, 74, 58, 0.42),
    0 0 10rpx rgba(88, 74, 58, 0.18);
}

@media (min-width: 520px) {
  .entry-arrow {
    font-size: 34px;
  }

  .entry-hint {
    font-size: 16px;
  }

  .entry-loading-panel { padding: 40px; }
  .entry-artwork-info { gap: 7px; max-width: 360px; }
  .entry-artwork-title { font-size: 22px; }
  .entry-artwork-line { font-size: 14px; }
  .entry-loading-line { font-size: 13px; gap: 8px; margin-top: 10px; }
  .entry-loading-dots text { width: 5px; height: 5px; }
}


.archive-notice {
  position: fixed;
  z-index: 30;
  left: 28rpx;
  right: 28rpx;
  top: calc(24rpx + env(safe-area-inset-top));
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(63, 49, 43, 0.78);
  backdrop-filter: blur(16rpx);
  color: #fff7ef;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}
