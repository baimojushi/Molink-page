page {
  background: #fff4df;
}

.page-shell {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #fff4df;
}

.safe-top,
.preview-safe-top {
  height: env(safe-area-inset-top);
}

.current-page,
.next-page-preview {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  will-change: transform, opacity;
  backface-visibility: hidden;
  transform: translateZ(0);
}

.next-page-preview {
  z-index: 1;
  opacity: 0.16;
  transform: translate3d(0, 38px, 0) scale(0.968);
  background: linear-gradient(180deg, rgba(255, 244, 223, 0.96) 0%, rgba(255, 244, 223, 1) 48%, rgba(250, 239, 214, 1) 100%);
}

.current-page {
  z-index: 2;
  background: #fff4df;
}

.hero-stage {
  position: relative;
  width: 100%;
  height: 1104rpx;
  padding-top: 58rpx;
}

.hero-image-shell {
  position: absolute;
  top: 132rpx;
  left: 72rpx;
  width: 518rpx;
  height: 780rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: #ded5c3;
  box-shadow: 0 16rpx 42rpx rgba(91, 81, 68, 0.16);
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-image-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(232, 225, 211, 1) 0%, rgba(218, 207, 187, 1) 100%);
}

.hero-image-fallback-text {
  font-size: 24rpx;
  color: rgba(119, 110, 97, 0.8);
  letter-spacing: 2rpx;
}

.brand-mask {
  position: absolute;
  top: 36rpx;
  left: 54rpx;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 300;
  letter-spacing: 8rpx;
  color: rgba(143, 133, 116, 0.42);
}

.info-card {
  position: absolute;
  right: 44rpx;
  bottom: 134rpx;
  z-index: 3;
  box-sizing: border-box;
  width: 392rpx;
  min-height: 362rpx;
  padding: 44rpx 34rpx 34rpx;
  overflow: hidden;
  border-radius: 32rpx;
  border-top-left-radius: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: linear-gradient(180deg, rgba(232, 231, 214, 0.92) 0%, rgba(224, 221, 205, 0.88) 100%);
  box-shadow:
    0 14rpx 30rpx rgba(95, 88, 79, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.58);
}

.info-card-gloss {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 112rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 255, 255, 0) 100%);
}

.art-title {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 26rpx;
  text-align: center;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 500;
  color: #565148;
}

.copy-list {
  position: relative;
  z-index: 1;
}

.copy-line {
  display: block;
  margin-top: 10rpx;
  text-align: center;
  font-size: 14px;
  line-height: 1.85;
  color: rgba(102, 97, 89, 0.9);
}

.copy-line:first-child {
  margin-top: 0;
}

.error-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 176rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(156, 96, 76, 0.9);
}

.swipe-cta {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  z-index: 4;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.swipe-arrow {
  width: 78rpx;
  height: 28rpx;
  background: no-repeat center/contain;
  position: relative;
}

.swipe-arrow::before,
.swipe-arrow::after {
  content: '';
  position: absolute;
  top: 6rpx;
  width: 38rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #a49686;
}

.swipe-arrow::before {
  left: 4rpx;
  transform: rotate(-26deg);
  transform-origin: left center;
}

.swipe-arrow::after {
  right: 4rpx;
  transform: rotate(26deg);
  transform-origin: right center;
}

.swipe-text {
  font-size: 14px;
  line-height: 1.4;
  color: #a49686;
}

.preview-header {
  padding: 74rpx 40rpx 0;
}

.preview-service-tag {
  display: block;
  margin-bottom: 18rpx;
  font-size: 24rpx;
  color: rgba(112, 146, 109, 0.9);
}

.preview-page-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 60rpx;
  font-weight: 700;
  color: rgba(43, 38, 35, 0.96);
}

.preview-page-copy {
  display: block;
  font-size: 26rpx;
  color: rgba(78, 72, 66, 0.42);
}

.glass-panel {
  overflow: hidden;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: linear-gradient(180deg, rgba(247, 243, 235, 0.94) 0%, rgba(239, 233, 223, 0.82) 100%);
  box-shadow:
    0 12rpx 28rpx rgba(108, 98, 86, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.62);
}

.preview-select-row,
.preview-artwork,
.preview-placeholder {
  margin: 28rpx 38rpx 0;
}

.preview-select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 144rpx;
  padding: 0 26rpx 0 30rpx;
}

.preview-search-wrap {
  display: flex;
  align-items: center;
  flex: 1;
}

.preview-search-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(98, 107, 117, 0.8);
  box-sizing: border-box;
}

.preview-search-icon::after {
  content: '';
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(98, 107, 117, 0.8);
  transform: rotate(45deg);
}

.preview-search-copy {
  display: flex;
  flex-direction: column;
}

.preview-search-title {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(60, 53, 48, 0.94);
}

.preview-search-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(91, 84, 76, 0.48);
}

.preview-scan-wrap {
  position: relative;
  width: 112rpx;
  height: 88rpx;
  margin-left: 22rpx;
  opacity: 0.82;
}

.preview-scan-corner {
  position: absolute;
  width: 24rpx;
  height: 24rpx;
  border-color: rgba(110, 101, 89, 0.75);
  border-style: solid;
}

.preview-scan-corner.tl {
  left: 8rpx;
  top: 8rpx;
  border-width: 4rpx 0 0 4rpx;
  border-top-left-radius: 10rpx;
}

.preview-scan-corner.tr {
  right: 8rpx;
  top: 8rpx;
  border-width: 4rpx 4rpx 0 0;
  border-top-right-radius: 10rpx;
}

.preview-scan-corner.bl {
  left: 8rpx;
  bottom: 8rpx;
  border-width: 0 0 4rpx 4rpx;
  border-bottom-left-radius: 10rpx;
}

.preview-scan-corner.br {
  right: 8rpx;
  bottom: 8rpx;
  border-width: 0 4rpx 4rpx 0;
  border-bottom-right-radius: 10rpx;
}

.preview-artwork {
  display: flex;
  align-items: center;
  min-height: 142rpx;
  padding: 18rpx;
}

.preview-artwork-image {
  width: 106rpx;
  height: 106rpx;
  border-radius: 20rpx;
  background: #ded5c3;
}

.preview-artwork-copy {
  display: flex;
  flex-direction: column;
  margin-left: 18rpx;
}

.preview-artwork-tag {
  font-size: 22rpx;
  color: rgba(92, 84, 76, 0.54);
}

.preview-artwork-title {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(59, 53, 48, 0.94);
}

.preview-artwork-num {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(92, 84, 76, 0.54);
}

.preview-placeholder {
  height: 88rpx;
}

.preview-placeholder-sm {
  margin-top: 18rpx;
}

.preview-submit-wrap {
  display: flex;
  justify-content: center;
  margin-top: 430rpx;
}

.preview-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: rgba(166, 129, 89, 0.9);
  box-shadow: 0 16rpx 34rpx rgba(143, 110, 73, 0.18);
  color: rgba(255, 255, 255, 0.98);
  font-size: 32rpx;
  font-weight: 600;
}
