<view
  class="entry-page"
  bindtouchstart="onTouchStart"
  bindtouchmove="onTouchMove"
  bindtouchend="onTouchEnd"
  bindtouchcancel="onTouchCancel"
>
  <view wx:if="{{!canOrder && orderDisabledMessage}}" class="archive-notice">{{orderDisabledMessage}}</view>
  <view wx:if="{{heroImage}}" class="entry-hero-stage">
    <view
      class="entry-hero-track"
      style="width: {{heroDisplayWidth}}px; height: {{heroDisplayHeight}}px; top: {{heroTrackTop}}px; transform: translate3d({{heroTranslateX}}px, {{heroTranslateY}}px, 0);"
    >
      <image
        class="entry-hero {{heroImageVisible ? 'entry-hero-visible' : ''}}"
        src="{{heroImage}}"
        mode="scaleToFill"
        show-menu-by-longpress="{{false}}"
        bindload="onHeroImageLoad"
        binderror="onHeroImageError"
      ></image>
    </view>
  </view>

  <view wx:else class="entry-hero-fallback"></view>

  <view wx:if="{{loading && !errorText}}" class="entry-loading-panel">
    <view class="entry-artwork-info">
      <text wx:if="{{artworkTitle}}" class="entry-artwork-title">《{{artworkTitle}}》</text>
      <text wx:if="{{artworkAuthor}}" class="entry-artwork-line">{{artworkAuthor}}</text>
      <text wx:if="{{artworkSizeText}}" class="entry-artwork-line">尺寸：{{artworkSizeText}}</text>
      <text wx:if="{{artworkFrameSizeText}}" class="entry-artwork-line">装框尺寸：{{artworkFrameSizeText}}</text>
      <view class="entry-loading-line">
        <view class="entry-loading-dots"><text></text><text></text><text></text></view>
        <text>装饰效果加载中</text>
      </view>
    </view>
  </view>

  <view wx:if="{{heroImageVisible}}" class="entry-bottom-fade"></view>

  <view wx:if="{{errorText}}" class="entry-error">{{errorText}}</view>

  <view
    wx:if="{{heroImageVisible}}"
    class="entry-gesture"
    style="transform: translateY(-{{swipeOffset}}rpx);"
    bindtap="enterUpload"
  >
    <text class="entry-arrow">▲</text>
    <text class="entry-hint">{{canOrder ? '上滑挂进自己家' : '展览已结束 · 仅供浏览'}}</text>
  </view>
</view>
