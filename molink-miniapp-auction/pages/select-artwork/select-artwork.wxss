.page-container {
  padding: 32rpx 24rpx 160rpx;
  background: linear-gradient(160deg, #f5efe9 0%, #e8dfd5 100%);
  min-height: 100vh;
}

.header { margin-bottom: 32rpx; }
.page-title { display: block; font-size: 40rpx; font-weight: 600; color: #5a3e2b; }
.page-sub { display: block; font-size: 26rpx; color: #a08060; margin-top: 8rpx; }

.loading-tip { text-align: center; color: #a08060; padding: 80rpx 0; }

.artwork-grid { display: flex; flex-direction: column; gap: 24rpx; }

.artwork-card {
  display: flex;
  gap: 24rpx;
  background: rgba(255,255,255,0.6);
  border-radius: 20rpx;
  padding: 20rpx;
  border: 2rpx solid transparent;
  position: relative;
  transition: all 0.2s;
}
.artwork-card.selected {
  border-color: #917355;
  background: rgba(145, 115, 85, 0.08);
}

.artwork-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8dfd5;
}

.artwork-info { flex: 1; display: flex; flex-direction: column; gap: 8rpx; justify-content: center; }
.artwork-name { font-size: 30rpx; font-weight: 600; color: #3d2b1f; }
.artwork-author { font-size: 26rpx; color: #917355; }
.artwork-meta { font-size: 24rpx; color: #a08060; }
.artwork-price { font-size: 24rpx; color: #7a9e7e; margin-top: 4rpx; }

.check-mark {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  background: #917355;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245,239,233,0.98) 60%, transparent);
}
