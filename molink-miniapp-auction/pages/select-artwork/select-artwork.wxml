<view class="page-container">
  <view class="header">
    <text class="page-title">选择作品</text>
    <text class="page-sub">共 {{artworks.length}} 件参展作品</text>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

  <view class="artwork-grid" wx:else>
    <view
      class="artwork-card {{selected && selected.id === item.id ? 'selected' : ''}} {{item.display_price || item.price ? 'has-price' : ''}}"
      wx:for="{{artworks}}"
      wx:key="id"
      data-artwork="{{item}}"
      bindtap="selectArtwork"
    >
      <image
        class="artwork-img"
        src="{{item.list_image_url || item.images[0]}}"
        mode="aspectFill"
        lazy-load
        catchtap="previewArtwork"
        data-artwork="{{item}}"
      />
      <view class="artwork-info">
        <text class="artwork-name">{{item.name || '（无题）'}}</text>
        <text class="artwork-author">{{item.author}}</text>
        <text wx:if="{{item.artwork_code}}" class="artwork-code">作品代码 {{item.artwork_code}}</text>
        <text class="artwork-meta">{{item.display_size || ''}}</text>
        <text wx:if="{{item.display_frame_size}}" class="artwork-meta">装裱尺寸 {{item.display_frame_size}}</text>
      </view>
      <text wx:if="{{item.display_price || item.price}}" class="artwork-price">{{item.display_price || item.price}}</text>
      <view wx:if="{{selected && selected.id === item.id}}" class="check-mark">✓</view>
    </view>
  </view>

  <view class="bottom-bar">
    <button
      class="btn-primary {{selected ? '' : 'disabled'}}"
      bindtap="confirmSelection"
    >确认选择{{selected ? '：' + (selected.name || '（无题）') : ''}}</button>
  </view>
</view>
