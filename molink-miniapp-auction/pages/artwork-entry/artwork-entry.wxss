page {
  background: #000;
}

.entry-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #000;
}

.entry-hero {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.entry-bottom-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 34vh;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.18) 36%, rgba(255,255,255,0.72) 76%, rgba(255,255,255,0.96) 100%);
}

.entry-gesture {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 180ms ease;
}

.entry-arrow {
  font-size: 54rpx;
  line-height: 1;
  color: rgba(255,255,255,0.96);
  transform: rotate(-90deg);
  text-shadow: 0 10rpx 22rpx rgba(0,0,0,0.16);
}

.entry-hint {
  font-size: 28rpx;
  letter-spacing: 4rpx;
  color: rgba(255,255,255,0.98);
  text-shadow: 0 8rpx 18rpx rgba(0,0,0,0.18);
}
