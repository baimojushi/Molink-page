.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.success-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.result-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-sub);
  margin-bottom: 20rpx;
}

.image-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.image-item {
  overflow: hidden;
}

.delivery-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.image-actions {
  padding: 16rpx 24rpx;
  display: flex;
  justify-content: flex-end;
}

.action-btn {
  font-size: 24rpx;
  color: var(--color-primary);
  background: transparent;
  border: none;
  padding: 8rpx 0;
}

.action-btn::after { border: none; }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--color-text-hint);
}

.again-section {
  padding-bottom: 60rpx;
}

.privacy-notice {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: rgba(90, 90, 90, 0.28);
  margin-top: 20rpx;
}

@media (min-width: 520px) {
  .privacy-notice { font-size: 11px; }
}

.other-orders-banner {
  background: rgba(122, 158, 126, 0.12);
  border: 1rpx solid rgba(122, 158, 126, 0.3);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.other-orders-text {
  font-size: 26rpx;
  color: var(--color-accent);
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.other-order-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(122, 158, 126, 0.2);
}

.other-order-label {
  font-size: 26rpx;
  color: var(--color-text-main);
}

.other-order-arrow {
  font-size: 24rpx;
  color: var(--color-accent);
}

@media (min-width: 520px) {
  .result-header { padding: 32px 0 24px; }
  .success-icon { width: 52px; height: 52px; font-size: 22px; margin-bottom: 14px; }
  .result-title { font-size: 22px; margin-bottom: 4px; }
  .result-sub { font-size: 13px; }
  .section-label { font-size: 14px; margin-bottom: 12px; }
  .image-list { gap: 14px; margin-bottom: 28px; }
  .delivery-img { height: 280px; }
  .image-actions { padding: 10px 14px; }
  .action-btn { font-size: 13px; }
  .other-orders-banner { padding: 14px 16px; margin-bottom: 18px; }
  .other-orders-text { font-size: 13px; margin-bottom: 10px; }
  .other-order-item { padding: 10px 0; }
  .other-order-label { font-size: 13px; }
  .other-order-arrow { font-size: 13px; }
  .again-section { padding-bottom: 36px; }
}
