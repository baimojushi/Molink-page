.fullscreen-viewer {
  position: fixed;
  inset: 0;
  z-index: 9999;
  overflow: hidden;
  background: #090909;
  color: #fff;
}

.fullscreen-viewer-topbar {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 4;
  min-height: 104rpx;
  padding: calc(env(safe-area-inset-top) + 18rpx) 28rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0));
}

.fullscreen-viewer-tip {
  padding-right: 24rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.fullscreen-viewer-close {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  line-height: 1;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(14rpx);
}

.fullscreen-viewer-area {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.fullscreen-viewer-canvas {
  width: 100%;
  height: 100%;
}

.fullscreen-viewer-image {
  width: 100%;
  height: 100%;
  display: block;
}

.fullscreen-viewer-controls {
  position: absolute;
  left: 50%;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  z-index: 4;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(20, 20, 20, 0.72);
  backdrop-filter: blur(18rpx);
}

.fullscreen-viewer-button,
.fullscreen-viewer-reset {
  height: 62rpx;
  min-width: 62rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.13);
  color: #fff;
  font-size: 32rpx;
}

.fullscreen-viewer-reset {
  min-width: 92rpx;
  font-size: 23rpx;
}

.fullscreen-viewer-scale {
  min-width: 82rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}
