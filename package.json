{
  "name": "molink-design",
  "version": "1.0.0",
  "description": "Mo:link Design 艺术作品空间匹配服务平台",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "pro:smoke": "node scripts/proSmoke.js",
    "artworks:backfill-thumbs": "node scripts/backfillArtworkThumbnails.js",
    "deliveries:backfill-r2": "node scripts/backfillDeliveryImagesToR2.js",
    "exhibitions:backfill": "node scripts/backfillExhibitionIsolation.js",
    "exhibitions:smoke": "node scripts/exhibitionIsolationSmoke.js",
    "miniapp:switch-account": "node scripts/switchMiniappAccount.js",
    "content-security:smoke": "node scripts/contentSecuritySmoke.js",
    "primary-rerender:smoke": "node scripts/primaryWallRerenderStatusSmoke.js",
    "eta:test": "node --test tests/eta/*.test.js",
    "workerhub:test": "node --test tests/workerHub/*.test.js",
    "v25:test": "node --test tests/client/*.test.js && node scripts/phase2ContractSmoke.js",
    "v29:test": "node --test tests/client/paginationGuard.test.js tests/client/orderFailurePublic.test.js tests/client/uiContracts.test.js tests/client/wallInteraction.test.js",
    "sqlite:schema-audit": "node scripts/sqliteOrdersSchemaAudit.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "tencentcloud-sdk-nodejs-ses": "^4.0.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "better-sqlite3": "^9.4.3",
    "uuid": "^9.0.0",
    "sharp": "^0.33.2",
    "archiver": "^6.0.1",
    "dotenv": "^16.3.1",
    "@aws-sdk/client-s3": "^3.821.0",
    "ws": "^8.16.0"
  }
}
