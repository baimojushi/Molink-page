.waiting-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.content-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
}

.loader-wrap {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  margin-bottom: 60rpx;
}

.loader {
  width: 100%;
  height: 100%;
  position: relative;
  animation: spin 1.2s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: var(--color-primary);
  opacity: 0.2;
  animation: fade 1.2s linear infinite;
}

@keyframes fade {
  0%, 100% { opacity: 0.2; }
  50% { opacity: 1; }
}

.waiting-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.waiting-desc {
  font-size: 28rpx;
  color: var(--color-text-sub);
  text-align: center;
  line-height: 1.8;
  white-space: pre-line;
  margin-bottom: 48rpx;
}

.info-card {
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.waiting-tip {
  font-size: 24rpx;
  color: var(--color-text-hint);
  text-align: center;
  line-height: 1.8;
  white-space: pre-line;
}

.notify-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  gap: 20rpx;
  margin-bottom: 40rpx;
  width: 100%;
  box-sizing: border-box;
}

.notify-card.subscribed {
  justify-content: center;
  background: rgba(122, 158, 126, 0.1);
  border: 1rpx solid rgba(122, 158, 126, 0.3);
}

.notify-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.notify-content {
  flex: 1;
}

.notify-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 6rpx;
}

.notify-desc {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
}

.notify-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--color-primary-light);
  border-radius: 40rpx;
}

.notify-done {
  font-size: 26rpx;
  color: var(--color-accent);
  font-weight: 500;
}

.back-home-btn {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: 16rpx;
  padding: 16rpx;
}

@media (min-width: 520px) {
  .content-center { padding-top: 48px; }
  .loader-wrap { width: 72px; height: 72px; margin-bottom: 36px; }
  .dot { width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; }
  .waiting-title { font-size: 22px; margin-bottom: 12px; }
  .waiting-desc { font-size: 14px; margin-bottom: 28px; }
  .info-card { padding: 14px 24px; gap: 14px; margin-bottom: 28px; }
  .info-label { font-size: 13px; }
  .info-value { font-size: 14px; }
  .waiting-tip { font-size: 13px; }
  .notify-card { padding: 16px 20px; gap: 12px; margin-bottom: 24px; }
  .notify-icon { font-size: 22px; }
  .notify-title { font-size: 14px; margin-bottom: 4px; }
  .notify-desc { font-size: 12px; }
  .notify-btn { font-size: 13px; padding: 6px 14px; }
  .notify-done { font-size: 13px; }
  .back-home-btn { font-size: 13px; margin-top: 10px; padding: 10px; }
}
