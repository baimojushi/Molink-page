.section { margin-bottom: 32rpx; overflow: hidden; }

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.row-label { font-size: 26rpx; color: var(--color-text-hint); }
.row-value { font-size: 28rpx; color: var(--color-text-main); font-weight: 500; }
.status-pending { color: #e67e22; }
.status-processing { color: #2980b9; }
.status-completed { color: #27ae60; }

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-sub);
  margin: 0 0 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.count-hint { font-size: 24rpx; color: var(--color-text-hint); font-weight: 400; }

.source-images { margin-bottom: 40rpx; padding: 24rpx; }

.source-item { margin-bottom: 20rpx; }
.source-item:last-child { margin-bottom: 0; }

.img-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.source-img {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-md);
  display: block;
}

.delivery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.delivery-item {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.delivery-img { width: 100%; height: 260rpx; display: block; }

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.upload-btn {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx dashed var(--color-primary-light);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.upload-btn.hidden { display: none; }
.upload-btn::after { border: none; }

.deliver-section { margin-bottom: 60rpx; }

.completed-tip {
  text-align: center;
  color: #27ae60;
  font-size: 28rpx;
  padding: 32rpx 0 60rpx;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--color-text-hint);
}

.delete-order-section {
  margin: 16rpx 0 60rpx;
}

.btn-delete-order {
  width: 100%;
  background: transparent;
  color: #c0392b;
  border: 2rpx solid rgba(192,57,43,0.3);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.btn-delete-order::after { border: none; }

/* AI 审核区域 */
.ai-section {
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.ai-status-label {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-main);
  margin-bottom: 24rpx;
  font-weight: 500;
}

.btn-refresh {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary-light);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  padding: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.btn-refresh::after { border: none; }

.ai-result-img {
  width: 100%;
  border-radius: var(--radius-md);
  display: block;
  margin-bottom: 28rpx;
}

.ai-actions {
  display: flex;
  gap: 20rpx;
}

.btn-approve {
  flex: 2;
  background: var(--color-primary);
  color: #fff;
  border: none;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  padding: 28rpx 0;
}
.btn-approve::after { border: none; }

.btn-regen {
  flex: 1;
  background: transparent;
  color: var(--color-text-sub);
  border: 2rpx solid rgba(0,0,0,0.15);
  border-radius: var(--radius-lg);
  font-size: 26rpx;
  padding: 28rpx 0;
}
.btn-regen::after { border: none; }

.status-ai_generating { color: #e67e22; }
.status-ai_ready { color: #8e44ad; }

.status-delivered { color: #27ae60; }
.status-viewed { color: #219a52; }
.status-downloaded { color: #4a7c4e; font-weight: 600; }

@media (min-width: 520px) {
  .section { margin-bottom: 18px; }
  .section-row { padding: 14px 16px; }
  .row-label { font-size: 13px; }
  .row-value { font-size: 14px; }
  .section-title { font-size: 14px; margin: 0 0 10px; }
  .count-hint { font-size: 13px; }
  .source-images { padding: 14px; margin-bottom: 24px; }
  .source-img { height: 200px; }
  .delivery-img { height: 160px; }
  .delivery-grid { gap: 10px; margin-bottom: 14px; }
  .upload-btn { padding: 16px; font-size: 14px; margin-bottom: 14px; }
  .deliver-section { margin-bottom: 36px; }
  .completed-tip { font-size: 14px; padding: 18px 0 36px; }
  .delete-order-section { margin: 10px 0 36px; }
  .btn-delete-order { font-size: 13px; padding: 14px; }
}
