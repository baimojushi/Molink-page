<view class="page-container" wx:if="{{order}}">

  <!-- 订单信息 -->
  <view class="section glass-card">
    <view class="section-row">
      <text class="row-label">服务类型</text>
      <text class="row-value">{{order.serviceLabel}}</text>
    </view>
    <view class="divider"></view>
    <view class="section-row">
      <text class="row-label">提交时间</text>
      <text class="row-value">{{order.submitTimeFormatted}}</text>
    </view>
    <view class="divider" wx:if="{{order.email}}"></view>
    <view class="section-row" wx:if="{{order.email}}">
      <text class="row-label">邮箱</text>
      <text class="row-value">{{order.email}}</text>
    </view>
    <view class="divider" wx:if="{{order.artwork_size}}"></view>
    <view class="section-row" wx:if="{{order.artwork_size}}">
      <text class="row-label">作品尺寸</text>
      <text class="row-value">{{order.artwork_size}}</text>
    </view>
    <view class="divider" wx:if="{{order.extra_service}}"></view>
    <view class="section-row" wx:if="{{order.extra_service}}">
      <text class="row-label">附加</text>
      <text class="row-value">顺带微调软装细节</text>
    </view>
    <view class="divider" wx:if="{{order.notes}}"></view>
    <view class="section-row" wx:if="{{order.notes}}">
      <text class="row-label">藏家备注</text>
      <text class="row-value">{{order.notes}}</text>
    </view>
    <view class="divider"></view>
    <view class="section-row">
      <text class="row-label">状态</text>
      <text class="row-value status-{{order.status}}">{{order.statusText}}</text>
    </view>
  </view>

  <!-- 藏家上传的图片 -->
  <view class="section-title">藏家上传的图片</view>
  <view class="source-images glass-card">
    <view wx:if="{{order.artworkImage}}" class="source-item">
      <text class="img-label">作品图</text>
      <image
        class="source-img"
        src="{{order.artworkImage}}"
        mode="aspectFill"
        bindtap="previewSourceImage"
        data-src="{{order.artworkImage}}"
      />
    </view>
    <view wx:if="{{order.spaceImage}}" class="source-item">
      <text class="img-label">空间图</text>
      <image
        class="source-img"
        src="{{order.spaceImage}}"
        mode="aspectFill"
        bindtap="previewSourceImage"
        data-src="{{order.spaceImage}}"
      />
    </view>
  </view>

  <!-- AI 审核区（生图中 / 待审核） -->
  <view wx:if="{{order.status === 'ai_generating'}}" class="ai-section glass-card">
    <text class="ai-status-label">⏳ AI 效果图生成中，请稍候…</text>
    <button class="btn-refresh" bindtap="loadOrder">刷新状态</button>
  </view>

  <view wx:elif="{{order.status === 'ai_ready'}}" class="ai-section glass-card">
    <text class="ai-status-label">AI 效果图已生成，请审核</text>
    <image
      class="ai-result-img"
      src="{{order.aiResultUrl}}"
      mode="widthFix"
      bindtap="previewAiResult"
    />
    <view class="ai-actions">
      <button class="btn-approve {{delivering ? 'disabled' : ''}}" bindtap="approve" disabled="{{delivering}}">
        {{delivering ? '发送中…' : '✓ 通过，发给藏家'}}
      </button>
      <button class="btn-regen {{delivering ? 'disabled' : ''}}" bindtap="regenerate" disabled="{{delivering}}">
        ↺ 重新生成
      </button>
    </view>
  </view>

  <!-- 手动上传效果图（仅 pending/processing 状态显示） -->
  <view wx:if="{{order.status === 'pending' || order.status === 'processing'}}">
    <view class="section-title">
      <text>效果图</text>
      <text class="count-hint">{{order.deliveryImages.length}} 张</text>
    </view>
    <view class="delivery-grid" wx:if="{{order.deliveryImages.length > 0}}">
      <view class="delivery-item" wx:for="{{order.deliveryImages}}" wx:key="*this">
        <image class="delivery-img" src="{{item}}" mode="aspectFill" bindtap="previewDelivery" data-src="{{item}}" />
        <view class="delete-btn" bindtap="removeDeliveryImage" data-index="{{index}}">✕</view>
      </view>
    </view>
    <button class="upload-btn {{uploading ? 'disabled' : ''}}" bindtap="uploadDelivery" disabled="{{uploading}}">
      {{uploading ? '上传中...' : '+ 上传效果图'}}
    </button>
    <view class="deliver-section">
      <button class="btn-accent {{delivering ? 'disabled' : ''}}" bindtap="deliver" disabled="{{delivering}}">
        {{delivering ? '交付中...' : '交付给藏家并发送通知'}}
      </button>
    </view>
  </view>

  <!-- 已完成交付 -->
  <view class="completed-tip" wx:if="{{order.status === 'delivered' || order.status === 'viewed' || order.status === 'downloaded'}}">
    <text>✓ 已完成交付</text>
  </view>

  <!-- 删除订单 -->
  <view class="delete-order-section">
    <button class="btn-delete-order" bindtap="deleteOrder">删除此订单</button>
  </view>

</view>

<view class="loading-page" wx:else>
  <text class="loading-text">加载中...</text>
</view>
