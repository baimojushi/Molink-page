.waiting-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.content-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 48rpx;
}

.loader-wrap {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 56rpx;
}

.loader {
  width: 100%;
  height: 100%;
  position: relative;
  animation: rotate 1.2s linear infinite;
}

.dot {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin: -5rpx 0 0 -5rpx;
  border-radius: 50%;
  background: var(--color-primary);
  transform-origin: center center;
  opacity: 0.15;
}

.dot:nth-child(1) { animation: fade 1.2s 0s linear infinite; }
.dot:nth-child(2) { animation: fade 1.2s 0.1s linear infinite; }
.dot:nth-child(3) { animation: fade 1.2s 0.2s linear infinite; }
.dot:nth-child(4) { animation: fade 1.2s 0.3s linear infinite; }
.dot:nth-child(5) { animation: fade 1.2s 0.4s linear infinite; }
.dot:nth-child(6) { animation: fade 1.2s 0.5s linear infinite; }
.dot:nth-child(7) { animation: fade 1.2s 0.6s linear infinite; }
.dot:nth-child(8) { animation: fade 1.2s 0.7s linear infinite; }
.dot:nth-child(9) { animation: fade 1.2s 0.8s linear infinite; }
.dot:nth-child(10) { animation: fade 1.2s 0.9s linear infinite; }
.dot:nth-child(11) { animation: fade 1.2s 1.0s linear infinite; }
.dot:nth-child(12) { animation: fade 1.2s 1.1s linear infinite; }

@keyframes fade {
  0%, 100% { opacity: 0.15; }
  50% { opacity: 1; }
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.waiting-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.waiting-desc {
  font-size: 28rpx;
  color: var(--color-text-sub);
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.info-card {
  width: 100%;
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.waiting-tip {
  font-size: 24rpx;
  color: var(--color-text-disabled);
  line-height: 1.8;
}
