<view class="page-container">
  <!-- 标题 -->
  <view class="header">
    <text class="service-tag">{{serviceLabel}}</text>
    <text class="page-title">上传图片</text>
  </view>

  <!-- 上传区域 -->
  <view class="upload-section" wx:for="{{uploadConfig}}" wx:key="key">
    <view class="upload-label">{{item.label}}</view>
    <view class="upload-hint">{{item.hint}}</view>

    <!-- 已上传图片 -->
    <view class="image-preview glass-card" wx:if="{{images[item.key]}}">
      <image
        class="preview-img"
        src="{{images[item.key]}}"
        mode="aspectFill"
        bindtap="previewImage"
        data-src="{{images[item.key]}}"
      />
      <view class="remove-btn" bindtap="removeImage" data-key="{{item.key}}">
        <text>✕</text>
      </view>
    </view>

    <!-- 上传按钮 -->
    <view class="upload-box glass-card" wx:else bindtap="chooseImage" data-key="{{item.key}}">
      <text class="upload-icon">+</text>
      <text class="upload-text">点击上传</text>
    </view>
  </view>

  <!-- 邮箱（可选） -->
  <view class="email-section">
    <view class="email-toggle" bindtap="toggleEmail">
      <text class="toggle-label">接收邮件通知（可选）</text>
      <text class="toggle-arrow">{{showEmail ? '▲' : '▼'}}</text>
    </view>
    <view class="email-input-wrap" wx:if="{{showEmail}}">
      <input
        class="email-input glass-card"
        type="text"
        placeholder="请输入您的邮箱"
        placeholder-class="input-placeholder"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <button
      class="btn-primary {{submitting ? 'disabled' : ''}}"
      bindtap="submitOrder"
      disabled="{{submitting}}"
    >
      <text wx:if="{{!submitting}}">提交委托</text>
      <text wx:else>提交中...</text>
    </button>
    <text class="submit-tip">提交时将询问是否接收效果图完成通知</text>
  </view>
</view>
