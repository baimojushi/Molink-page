.header {
  padding: 40rpx 0 48rpx;
}

.service-tag {
  display: inline-block;
  background: var(--color-primary-pale);
  color: var(--color-primary);
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  margin-bottom: 16rpx;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.upload-section {
  margin-bottom: 40rpx;
}

.upload-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 20rpx;
}

.upload-box {
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-primary-light);
  background: rgba(245, 240, 235, 0.5) !important;
}

.upload-icon {
  font-size: 72rpx;
  color: var(--color-primary-light);
  line-height: 1;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.image-preview {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.email-section {
  margin-bottom: 160rpx;
}

.email-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--color-bg-deep);
}

.toggle-label {
  font-size: 28rpx;
  color: var(--color-text-sub);
}

.toggle-arrow {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.email-input {
  width: 100%;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  box-sizing: border-box;
  margin-top: 16rpx;
}

.input-placeholder {
  color: var(--color-text-disabled);
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 239, 233, 0.98) 60%, transparent);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.submit-tip {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.btn-primary.disabled {
  background: var(--color-text-disabled);
}
