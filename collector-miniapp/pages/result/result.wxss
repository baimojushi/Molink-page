.result-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 48rpx;
}

.success-icon {
  width: 96rpx;
  height: 96rpx;
  background: var(--color-accent);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.result-sub {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-sub);
  margin-bottom: 20rpx;
}

.image-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.image-item {
  overflow: hidden;
}

.delivery-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.image-actions {
  padding: 20rpx 24rpx;
}

.action-btn {
  background: transparent;
  color: var(--color-primary);
  font-size: 26rpx;
  border: none;
  padding: 0;
  text-align: left;
}

.action-btn::after {
  border: none;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
}

.empty-text {
  color: var(--color-text-hint);
  font-size: 28rpx;
}

.again-section {
  margin-top: 16rpx;
  padding-bottom: 60rpx;
}
