/* 全局样式 */
page {
  --color-primary: #917355;
  --color-primary-light: #B5A091;
  --color-primary-pale: #F5F0EB;
  --color-primary-dark: #806A54;
  --color-accent: #7a9e7e;
  --color-accent-light: #a8c5ab;
  --color-accent-dark: #5a7e5e;
  --color-text-main: #2a2a2a;
  --color-text-sub: #5a5a5a;
  --color-text-hint: #8a8a8a;
  --color-text-disabled: #c8b8a8;
  --color-bg: #f5efe9;
  --color-bg-deep: #e8dfd5;
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;

  background-color: var(--color-bg);
  color: var(--color-text-main);
  font-family: -apple-system, PingFang SC, Microsoft YaHei, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 玻璃卡片 */
.glass-card {
  background: rgba(255, 252, 248, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 24rpx rgba(145, 115, 85, 0.1);
}

/* 主按钮 */
.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--radius-xl);
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  width: 100%;
  box-sizing: border-box;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 次按钮 */
.btn-secondary {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-xl);
  padding: 22rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

/* 页面容器 */
.page-container {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(160deg, #f5efe9 0%, #e8dfd5 100%);
}

/* 标题 */
.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-main);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-bottom: 48rpx;
}
