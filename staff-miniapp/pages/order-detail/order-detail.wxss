.section {
  margin-bottom: 32rpx;
  overflow: hidden;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.row-label {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.row-value {
  font-size: 28rpx;
  color: var(--color-text-main);
  font-weight: 500;
}

.status-pending { color: #e67e22; }
.status-processing { color: #2980b9; }
.status-completed { color: #27ae60; }

.divider {
  height: 1rpx;
  background: var(--color-bg-deep);
  margin: 0 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-sub);
  margin: 0 0 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.count-hint {
  font-size: 24rpx;
  color: var(--color-text-hint);
  font-weight: 400;
}

.source-images {
  margin-bottom: 40rpx;
  padding: 24rpx;
}

.source-item {
  margin-bottom: 20rpx;
}

.source-item:last-child {
  margin-bottom: 0;
}

.img-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.source-img {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-md);
  display: block;
}

.delivery-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.delivery-item {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.delivery-img {
  width: 100%;
  height: 260rpx;
  display: block;
}

.delete-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.upload-btn {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx dashed var(--color-primary-light);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.upload-btn.hidden {
  display: none;
}

.upload-btn::after {
  border: none;
}

.deliver-section {
  margin-bottom: 60rpx;
}

.btn-accent.disabled {
  background: var(--color-text-disabled);
}

.completed-tip {
  text-align: center;
  color: #27ae60;
  font-size: 28rpx;
  padding: 32rpx 0 60rpx;
}

.loading-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.loading-text {
  color: var(--color-text-hint);
}
